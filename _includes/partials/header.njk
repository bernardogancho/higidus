{% set nav = activeNav or "" %}
{% set currentPath = page.url or "" %}
{% set navItems = [
  { "key": "home", "label": "Início", "href": "/", "desktop": true, "mobile": true },
  { "key": "services", "label": "Serviços", "href": "/servicos/avaliacao-diagnostico/", "desktop": true, "mobile": true },
  { "key": "sectors", "label": "Setores", "href": "/setores/construcao/", "desktop": true, "mobile": true },
  { "key": "projects", "label": "Projetos", "href": "/projetos/", "desktop": true, "mobile": true },
  { "key": "company", "label": "Sobre Nós", "href": "/sobre-nos/", "desktop": true, "mobile": true },
  { "key": "certifications", "label": "Certificações", "href": "/certificacoes/", "desktop": true, "mobile": true },
  { "key": "blog", "label": "Blog", "href": "/blog/", "desktop": true, "mobile": true }
] %}
{% set serviceItems = [
  { "href": "/servicos/avaliacao-diagnostico/", "label": "Avaliação e Diagnóstico", "description": "Classificação, amostragem e análise de risco.", "image": "/assets/img/higidus-imagem.avif", "alt": "Avaliação e Diagnóstico de Solos" },
  { "href": "/servicos/remediacao-tratamento/", "label": "Remediação e Tratamento", "description": "Soluções in situ e ex situ para descontaminação.", "image": "/assets/img/soil-fixes.avif", "alt": "Remediação e Tratamento de Solos" },
  { "href": "/servicos/conformidade-regulacao/", "label": "Conformidade e Regulação", "description": "Licenciamento, monitorização e documentação.", "image": "/assets/img/conformidade.avif", "alt": "Conformidade e Regulação Ambiental" },
  { "href": "/servicos/manutencao-postos/", "label": "Manutenção de Postos", "description": "Inspeção, prevenção e controlo técnico contínuo.", "image": "/assets/img/gas-station-mom.avif", "alt": "Manutenção de Postos de Combustível" }
] %}
{% set sectorItems = [
  { "href": "/setores/construcao/", "label": "Construção", "description": "Escavação e gestão de solos em obra.", "image": "/assets/img/construction.avif", "alt": "Setor da Construção" },
  { "href": "/setores/industria/", "label": "Indústria", "description": "Reabilitação de passivos industriais.", "image": "/assets/img/industry.avif", "alt": "Setor da Indústria" },
  { "href": "/setores/postos-de-combustivel/", "label": "Postos de Combustível", "description": "Gestão ambiental e conformidade contínua.", "image": "/assets/img/gas-station-pump.avif", "alt": "Setor de Postos de Combustível" },
  { "href": "/setores/municipal/", "label": "Municipal", "description": "Projetos urbanos e apoio técnico regulatório.", "image": "/assets/img/municipal.avif", "alt": "Setor Municipal" }
] %}

<header data-site-header class="site-header sticky top-0 z-50 border-b backdrop-blur">
  <div class="mx-auto max-w-7xl px-6">
    <div class="header-main relative flex h-16 items-center justify-between gap-4">
      <a href="/" data-header-logo aria-label="Hígidus" class="inline-flex shrink-0 items-center">
        <img src="/assets/brand/higidus-icon.svg" alt="Hígidus" class="h-6 w-auto md:h-7" loading="eager" decoding="async">
      </a>
      <button type="button" data-header-menu-button data-mobile-toggle="mobile-menu-main" aria-expanded="false" aria-controls="mobile-menu-main" class="btn btn-secondary btn-md shrink-0 lg:hidden">Menu</button>
      <nav class="site-nav hidden min-w-0 lg:flex lg:flex-1 lg:justify-center" aria-label="Principal">
        <ul class="flex h-16 items-stretch gap-6 text-sm font-medium text-slate-800">
          {% for item in navItems %}
          {% if item.desktop %}
          {% if item.key == "services" %}
          <li class="nav-parent flex items-center">
            <a data-header-link class="nav-top-link {{ 'is-active' if nav == item.key else '' }}" href="{{ item.href }}" {% if nav == item.key %}aria-current="page"{% endif %}>
              <span>{{ item.label }}</span>
              <i data-lucide="chevron-down" class="nav-chevron h-3.5 w-3.5" aria-hidden="true"></i>
            </a>
            <div class="nav-dropdown nav-dropdown-full absolute left-0 right-0 top-full z-50">
              <div class="border-b border-t border-slate-200 bg-white shadow-[0_10px_18px_rgba(15,23,42,0.06)]">
                <div class="grid grid-cols-4 gap-2 p-2">
                  {% for service in serviceItems %}
                  <a href="{{ service.href }}" class="group block rounded-md border border-slate-200 {{ 'bg-[#0B3B2E]/5' if currentPath == service.href else 'hover:bg-slate-50' }}" {% if currentPath == service.href %}aria-current="page"{% endif %}>
                    <img src="{{ service.image }}" alt="{{ service.alt }}" class="h-32 w-full rounded-t-md object-cover object-center" loading="lazy" decoding="async">
                    <span class="block px-3 py-2.5">
                      <span class="block text-sm font-semibold leading-tight {{ 'text-[#0B3B2E]' if currentPath == service.href else 'text-slate-900' }}">{{ service.label }}</span>
                      <span class="mt-1 block text-xs leading-5 text-slate-600">{{ service.description }}</span>
                    </span>
                  </a>
                  {% endfor %}
                </div>
              </div>
            </div>
          </li>
          {% elseif item.key == "sectors" %}
          <li class="nav-parent flex items-center">
            <a data-header-link class="nav-top-link {{ 'is-active' if nav == item.key else '' }}" href="{{ item.href }}" {% if nav == item.key %}aria-current="page"{% endif %}>
              <span>{{ item.label }}</span>
              <i data-lucide="chevron-down" class="nav-chevron h-3.5 w-3.5" aria-hidden="true"></i>
            </a>
            <div class="nav-dropdown nav-dropdown-full absolute left-0 right-0 top-full z-50">
              <div class="border-b border-t border-slate-200 bg-white shadow-[0_10px_18px_rgba(15,23,42,0.06)]">
                <div class="grid grid-cols-4 gap-2 p-2">
                  {% for sector in sectorItems %}
                  <a href="{{ sector.href }}" class="group block rounded-md border border-slate-200 {{ 'bg-[#0B3B2E]/5' if currentPath == sector.href else 'hover:bg-slate-50' }}" {% if currentPath == sector.href %}aria-current="page"{% endif %}>
                    <img src="{{ sector.image }}" alt="{{ sector.alt }}" class="h-28 w-full rounded-t-md object-cover object-center" loading="lazy" decoding="async">
                    <span class="block px-3 py-2.5">
                      <span class="block text-sm font-semibold leading-tight {{ 'text-[#0B3B2E]' if currentPath == sector.href else 'text-slate-900' }}">{{ sector.label }}</span>
                      <span class="mt-1 block text-xs leading-5 text-slate-600">{{ sector.description }}</span>
                    </span>
                  </a>
                  {% endfor %}
                </div>
              </div>
            </div>
          </li>
          {% else %}
          <li class="nav-parent flex items-center">
            <a data-header-link class="nav-top-link {{ 'is-active' if nav == item.key else '' }}" href="{{ item.href }}" {% if nav == item.key %}aria-current="page"{% endif %}>
              <span>{{ item.label }}</span>
            </a>
          </li>
          {% endif %}
          {% endif %}
          {% endfor %}
        </ul>
      </nav>
      <div class="hidden shrink-0 items-center gap-2 lg:flex">
        <a href="/contacto/" data-header-contact class="btn btn-primary btn-md whitespace-nowrap {{ 'ring-2 ring-[#0B3B2E]/20 ring-offset-2 ring-offset-white' if nav == 'contact' else '' }}" {% if nav == 'contact' %}aria-current="page"{% endif %}>Contacto</a>
      </div>
    </div>
  </div>
  <div id="mobile-menu-main" data-mobile-menu class="border-t border-slate-200 bg-white px-6 py-4 lg:hidden">
    <div class="grid gap-2 text-sm font-medium text-slate-800">
      {% for item in navItems %}
      {% if item.mobile %}
      <a class="rounded-md px-3 py-2 {{ 'bg-[#0B3B2E]/10 text-[#0B3B2E]' if nav == item.key else 'hover:bg-slate-100' }}" href="{{ item.href }}" {% if nav == item.key %}aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endif %}
      {% endfor %}
      <a class="btn btn-primary btn-md justify-center {{ 'ring-2 ring-[#0B3B2E]/30' if nav == 'contact' else '' }}" href="/contacto/" {% if nav == 'contact' %}aria-current="page"{% endif %}>Contacto</a>
    </div>
  </div>
</header>
