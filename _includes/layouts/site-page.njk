<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
  {% set pageTitle = title %}
  {% set pageDescription = description %}
  {% set canonicalUrl = page.url | absoluteUrl(site.url) %}
  {% set pageOgTitle = ogTitle or pageTitle %}
  {% set pageOgDescription = ogDescription or pageDescription %}
  {% set pageOgImage = (ogImage or '/assets/img/og-image.svg') | absoluteUrl(site.url) %}
  {% set pageTwitterTitle = twitterTitle or pageOgTitle %}
  {% set pageTwitterDescription = twitterDescription or pageOgDescription %}
  {% set pageTwitterImage = (twitterImage or ogImage or '/assets/img/og-image.svg') | absoluteUrl(site.url) %}
  {% set pageRobots = robots or 'index, follow' %}
  {% set pageModified = (dateModified or page.date) | htmlDateString %}
  {% set breadcrumbCurrent = (breadcrumbTitle or title) | replace(" | Hígidus", "") %}
  {% set breadcrumbSectionLabel = "" %}
  {% set breadcrumbSectionUrl = "" %}
  {% if page.url.startsWith('/servicos/') %}
    {% set breadcrumbSectionLabel = "Serviços" %}
  {% elif page.url.startsWith('/setores/') %}
    {% set breadcrumbSectionLabel = "Setores" %}
  {% elif page.url.startsWith('/blog/') %}
    {% set breadcrumbSectionLabel = "Blog" %}
    {% set breadcrumbSectionUrl = "/blog/" %}
  {% endif %}

  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="robots" content="{{ pageRobots }}">
  <meta name="author" content="{{ author or site.author }}">
  <meta name="theme-color" content="{{ site.themeColor }}">
  <meta name="format-detection" content="telephone=no">
  {% if keywords %}
  <meta name="keywords" content="{{ keywords }}">
  {% endif %}

  <link rel="canonical" href="{{ canonicalUrl }}">
  <link rel="alternate" hreflang="pt-pt" href="{{ canonicalUrl }}">
  <link rel="alternate" hreflang="x-default" href="{{ canonicalUrl }}">
  <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
  <link rel="manifest" href="/site.webmanifest">

  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageOgTitle }}">
  <meta property="og:description" content="{{ pageOgDescription }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:image" content="{{ pageOgImage }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTwitterTitle }}">
  <meta name="twitter:description" content="{{ pageTwitterDescription }}">
  <meta name="twitter:image" content="{{ pageTwitterImage }}">

  <link rel="stylesheet" href="/assets/styles.css">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "{{ schemaType or 'WebPage' }}",
    "name": "{{ pageTitle | escape }}",
    "url": "{{ canonicalUrl }}",
    "inLanguage": "{{ site.language }}"{% if schemaType == 'Service' %},
    "serviceType": "{{ schemaServiceType or pageTitle | escape }}",
    "provider": {
      "@type": "Organization",
      "name": "{{ site.name }}",
      "url": "{{ site.url }}"
    },
    "areaServed": "{{ schemaAreaServed or 'PT' }}"{% elif includeDateModified != false %},
    "dateModified": "{{ pageModified }}"{% endif %}
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Início",
        "item": "{{ '/' | absoluteUrl(site.url) }}"
      }{% if breadcrumbSectionLabel %},
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ breadcrumbSectionLabel | json | safe }}{% if breadcrumbSectionUrl %},
        "item": "{{ breadcrumbSectionUrl | absoluteUrl(site.url) }}"{% endif %}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ breadcrumbCurrent | json | safe }},
        "item": "{{ canonicalUrl }}"
      }{% else %},
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ breadcrumbCurrent | json | safe }},
        "item": "{{ canonicalUrl }}"
      }{% endif %}
    ]
  }
  </script>
</head>
<body class="{{ bodyClass or 'bg-white text-slate-900 antialiased' }}">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:rounded-md focus:bg-white focus:px-3 focus:py-2 focus:text-slate-900">Saltar para o conteúdo</a>
  {% if showLayoutGuides != false %}
  <div class="layout-guides" aria-hidden="true"></div>
  {% endif %}

  {% include "partials/header.njk" %}

  <main id="main" {% if mainClass %}class="{{ mainClass }}"{% endif %}>
    {% if page.url != '/' %}
    {% include "partials/breadcrumbs.njk" %}
    {% endif %}
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  {% if includeFloatingWidgets != false %}
  {% include "partials/floating-widgets.njk" %}
  {% endif %}

  <script src="/assets/vendor/lucide.min.js" defer></script>
  <script src="/assets/site.js" defer></script>
</body>
</html>
