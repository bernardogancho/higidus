<!DOCTYPE html>
<html lang="pt-PT">
<head>
  {% set siteUrl = "https://example.com" %}
  {% set postTitle = seoTitle or (title ~ " | Blog Hígidus") %}
  {% set postDescription = description or "Insights técnicos sobre solos contaminados, remediação e conformidade ambiental." %}
  {% set postUrl = page.url | absoluteUrl(siteUrl) %}
  {% set postImage = coverImage | absoluteUrl(siteUrl) %}
  {% set postPublished = date | htmlDateString %}
  {% set postUpdated = dateModified | htmlDateString %}

  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ postTitle }}</title>
  <meta name="description" content="{{ postDescription }}">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="author" content="{{ author or 'Equipa Hígidus' }}">
  <meta name="theme-color" content="#0B3B2E">

  <link rel="canonical" href="{{ postUrl }}">
  <link rel="alternate" hreflang="pt-pt" href="{{ postUrl }}">
  <link rel="alternate" hreflang="x-default" href="{{ postUrl }}">
  <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">

  <meta property="og:type" content="article">
  <meta property="og:locale" content="pt_PT">
  <meta property="og:site_name" content="Hígidus">
  <meta property="og:title" content="{{ postTitle }}">
  <meta property="og:description" content="{{ postDescription }}">
  <meta property="og:url" content="{{ postUrl }}">
  <meta property="og:image" content="{{ postImage }}">
  <meta property="article:published_time" content="{{ postPublished }}">
  <meta property="article:modified_time" content="{{ postUpdated }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ postTitle }}">
  <meta name="twitter:description" content="{{ postDescription }}">
  <meta name="twitter:image" content="{{ postImage }}">

  <link rel="stylesheet" href="/assets/styles.css">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": "{{ title | escape }}",
    "description": "{{ postDescription | escape }}",
    "datePublished": "{{ postPublished }}",
    "dateModified": "{{ postUpdated }}",
    "image": "{{ postImage }}",
    "author": {
      "@type": "Person",
      "name": "{{ (author or 'Equipa Hígidus') | escape }}"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Hígidus",
      "url": "https://example.com/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://example.com/assets/brand/favicon.svg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "{{ postUrl }}"
    },
    "about": "Solos contaminados, remediação ambiental e conformidade regulatória em Portugal",
    "inLanguage": "pt-PT"
  }
  </script>
  {% include "partials/faq-schema.njk" %}
</head>
<body class="bg-white text-slate-900 antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-white focus:text-slate-900 focus:px-3 focus:py-2 focus:rounded-md">Saltar para o conteúdo</a>

  {% include "partials/header.njk" %}

  <div class="reading-progress" data-reading-progress aria-live="polite">
    <div class="reading-progress-track">
      <div class="reading-progress-fill" data-reading-progress-fill></div>
    </div>
  </div>

  <main id="main" class="border-b border-slate-200">
    <section class="blog-post-hero relative overflow-hidden border-b border-slate-800 text-white">
      <img src="{{ coverImage }}" alt="{{ title }}" class="absolute inset-0 h-full w-full object-cover" loading="eager" decoding="async">
      <div class="absolute inset-0 bg-[linear-gradient(110deg,rgba(2,6,23,0.72)_0%,rgba(2,6,23,0.56)_50%,rgba(2,6,23,0.68)_100%)]"></div>
      <div class="relative mx-auto max-w-6xl px-6 py-16 md:py-20">
        <a href="/blog/" class="blog-post-hero-backlink inline-flex items-center gap-2 text-sm">
          <i data-lucide="arrow-left" class="h-4 w-4" aria-hidden="true"></i>
          Voltar ao Blog
        </a>
        <div class="mt-6 grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-8">
            <p class="blog-eyebrow">Blog Hígidus</p>
            <h1 class="mt-3 max-w-4xl text-4xl font-semibold leading-[1.08] tracking-tight md:text-6xl">{{ title }}</h1>
            <p class="mt-5 max-w-3xl text-base leading-8 text-emerald-50/90 md:text-[1.12rem]">{{ postDescription }}</p>
            <div class="mt-6 flex flex-wrap items-center gap-2 text-sm text-emerald-50">
              <span class="rounded-full border border-white/25 bg-white/10 px-3 py-1">{{ date | readableDate }}</span>
              <span class="rounded-full border border-white/25 bg-white/10 px-3 py-1">{{ author or "Equipa Hígidus" }}</span>
              {% if topics and topics.length %}
              {% for topic in topics %}
              <span class="rounded-full border border-white/25 bg-white/10 px-3 py-1">{{ topic }}</span>
              {% endfor %}
              {% endif %}
            </div>
          </div>
          <aside class="lg:col-span-4">
            <div class="blog-glass-card rounded-md border border-white/30 bg-white/10 p-5 backdrop-blur-sm">
              <p class="text-xs uppercase tracking-[0.14em] text-emerald-100">Resumo Executivo</p>
              <p class="mt-3 text-sm leading-7 text-emerald-50/90">{{ postDescription }}</p>
              <div class="mt-4 border-t border-white/20 pt-4 text-xs text-emerald-100">
                <p>Atualizado em {{ postUpdated }}</p>
              </div>
              <a href="/contacto/" class="mt-5 inline-flex btn btn-outline-light btn-md">Falar com Especialista</a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <article class="bg-[#f7f9f9]">
      <div class="mx-auto grid max-w-6xl gap-8 px-6 py-12 md:py-14 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <div class="rounded-md border border-slate-200 bg-white p-7 md:p-10">
            <div class="prose-text blog-prose max-w-none text-base leading-8 text-slate-700 md:text-[1.08rem]" data-reading-content>
              {{ content | safe }}
            </div>
          </div>
        </div>

        <aside class="lg:col-span-4">
          <div class="sticky top-24 space-y-4">
            <nav class="rounded-md border border-slate-200 bg-white p-6" aria-label="Tabela de conteúdos" data-post-toc-wrap>
              <p class="blog-eyebrow">Neste artigo</p>
              <ul class="post-toc-list mt-4 space-y-1.5 text-sm leading-6 text-slate-700" data-post-toc></ul>
              <p class="mt-4 text-sm leading-7 text-slate-700" data-post-toc-empty>Este artigo não tem secções internas suficientes para gerar índice.</p>
            </nav>
            <div class="rounded-md border border-slate-200 bg-white p-6">
              <p class="blog-eyebrow">Apoio Técnico</p>
              <p class="mt-3 text-sm leading-7 text-slate-700">Se precisa de validar cenário em campo, traduzimos diagnóstico para plano de ação executável.</p>
              <a href="/contacto/" class="mt-4 inline-flex btn btn-primary btn-md">Pedir contacto</a>
            </div>
          </div>
        </aside>
      </div>

      <div class="mx-auto max-w-6xl px-6 pb-14">
        <div class="relative overflow-hidden rounded-md border border-slate-200 bg-slate-950 p-8 text-white md:p-10">
          <div class="pointer-events-none absolute inset-0">
            <div class="absolute -left-14 top-0 h-52 w-52 rounded-full bg-emerald-400/20 blur-3xl"></div>
            <div class="absolute right-0 bottom-0 h-56 w-56 rounded-full bg-cyan-400/15 blur-3xl"></div>
          </div>
          <p class="relative text-xs font-semibold uppercase tracking-[0.16em] text-emerald-100">Próximo passo</p>
          <h2 class="mt-3 text-3xl font-semibold leading-tight">Precisa de apoio técnico no terreno?</h2>
          <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-300">Transformamos diagnóstico em plano de ação executável, com foco em continuidade operacional e conformidade ambiental.</p>
          <div class="btn-group-responsive mt-6">
            <a href="/contacto/" class="btn btn-primary btn-md">Pedir contacto</a>
            <a href="/blog/" class="btn btn-outline-light btn-md">Ver mais artigos</a>
          </div>
        </div>
      </div>
    </article>
  </main>

  {% include "partials/footer.njk" %}

  {% include "partials/floating-widgets.njk" %}

  <script src="/assets/vendor/lucide.min.js" defer></script>
  <script src="/assets/site.js" defer></script>
</body>
</html>
