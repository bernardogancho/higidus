{
  "name": "higidus-site",
  "private": true,
  "version": "1.0.0",
  "description": "Hígidus multi-page website powered by Eleventy",
  "scripts": {
    "css:build": "tailwindcss -i ./assets/styles.input.css -o ./assets/styles.css --minify",
    "css:watch": "tailwindcss -i ./assets/styles.input.css -o ./assets/styles.css --watch",
    "dev": "concurrently -k -n CSS,11TY \"npm:css:watch\" \"eleventy --serve --port=8080\"",
    "build": "npm run css:build && eleventy",
    "clean": "rm -rf _site"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "lucide": "^0.575.0"
  }
}
