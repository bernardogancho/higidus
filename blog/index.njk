---
activeNav: blog
---
<!DOCTYPE html>
<html lang="pt-PT">
<head>
  {% set siteUrl = "https://example.com" %}
  {% set pageTitle = "Blog | HIGIDUS" %}
  {% set pageDescription = "Artigos técnicos sobre avaliação de solos, remediação ambiental e conformidade regulatória em Portugal." %}
  {% set pageUrl = "/blog/" | absoluteUrl(siteUrl) %}
  {% set pageImage = "/assets/img/hero-about.jpg" | absoluteUrl(siteUrl) %}

  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="theme-color" content="#0B3B2E">

  <link rel="canonical" href="{{ pageUrl }}">
  <link rel="alternate" hreflang="pt-pt" href="{{ pageUrl }}">
  <link rel="alternate" hreflang="x-default" href="{{ pageUrl }}">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">

  <meta property="og:type" content="website">
  <meta property="og:locale" content="pt_PT">
  <meta property="og:site_name" content="HIGIDUS">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ pageImage }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ pageImage }}">

  <link rel="stylesheet" href="/assets/styles.css">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": "Blog HIGIDUS",
    "url": "{{ pageUrl }}",
    "description": "{{ pageDescription | escape }}",
    "inLanguage": "pt-PT",
    "publisher": {
      "@type": "Organization",
      "name": "HIGIDUS",
      "url": "https://example.com/"
    },
    "blogPost": [
      {% for post in collections.blog %}
      {
        "@type": "BlogPosting",
        "headline": "{{ post.data.title | escape }}",
        "url": "{{ post.url | absoluteUrl(siteUrl) }}",
        "datePublished": "{{ post.date | htmlDateString }}",
        "description": "{{ post.data.description | escape }}"
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
</head>
<body class="bg-white text-slate-900 antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-white focus:text-slate-900 focus:px-3 focus:py-2 focus:rounded-md">Saltar para o conteúdo</a>

  {% include "partials/header.njk" %}

  {% set posts = collections.blog %}
  {% set latest = posts[0] if posts.length else null %}

  <main id="main" class="border-b border-slate-200">
    <section class="relative overflow-hidden border-b border-slate-200 bg-[linear-gradient(145deg,#f8fbfa_0%,#eef6f3_44%,#f4f7fb_100%)]">
      <div class="blog-pattern-hero" aria-hidden="true">
        <span class="blog-pattern-shape blog-pattern-shape-a"></span>
        <span class="blog-pattern-shape blog-pattern-shape-c"></span>
      </div>
      <div class="relative mx-auto max-w-7xl px-6 py-16 md:py-20">
        <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-7">
            <p class="blog-eyebrow">Blog HIGIDUS</p>
            <h1 class="mt-3 max-w-4xl text-4xl font-semibold leading-tight tracking-tight text-slate-900 md:text-6xl">Conteúdo técnico claro para decisões rápidas em campo.</h1>
            <p class="mt-5 max-w-3xl text-base leading-8 text-slate-600 md:text-[1.1rem]">Guias práticos sobre avaliação de solos, remediação e conformidade regulatória. Estruturado para quem precisa decidir sem perder tempo.</p>
            <div class="mt-8 flex flex-wrap gap-3">
              {% if latest %}
              <a href="{{ latest.url }}" class="btn btn-primary btn-md">Ler Último Artigo</a>
              {% endif %}
              <a href="/contacto/" class="btn btn-secondary btn-md">Falar com Especialista</a>
            </div>
          </div>
          <div class="lg:col-span-5">
            {% if latest %}
            <div class="blog-stripe-card-shell relative">
              <span class="blog-feature-backdrop" aria-hidden="true"></span>
              <article class="blog-stripe-feature-card relative overflow-hidden rounded-md border border-white/90 bg-white/90 shadow-[0_22px_44px_rgba(15,23,42,0.16)] backdrop-blur-sm">
                <div class="absolute right-4 top-4 rounded-full border border-slate-200 bg-white/95 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-[#0B3B2E]">Novo</div>
                <a href="{{ latest.url }}" class="block overflow-hidden">
                  <img src="{{ latest.data.coverImage or '/assets/img/hero-about.jpg' }}" alt="{{ latest.data.title }}" class="h-64 w-full object-cover transition duration-300 hover:scale-[1.02]" loading="lazy" decoding="async">
                </a>
                <div class="p-5">
                  <p class="blog-eyebrow">{{ latest.date | readableDate }}</p>
                  <h2 class="mt-2 text-2xl font-semibold leading-tight text-slate-900">
                    <a href="{{ latest.url }}" class="hover:text-[#0B3B2E]">{{ latest.data.title }}</a>
                  </h2>
                  <p class="mt-3 text-sm leading-7 text-slate-600">{{ latest.data.description }}</p>
                  <a href="{{ latest.url }}" class="mt-5 inline-flex btn-text">Continuar leitura</a>
                </div>
              </article>
            </div>
            {% else %}
            <div class="rounded-md border border-slate-200 bg-slate-50 p-7">
              <h2 class="text-2xl font-semibold text-slate-900">Sem artigos publicados</h2>
              <p class="mt-3 text-sm leading-7 text-slate-600">A estrutura está pronta. Publique o primeiro artigo em <strong>/admin</strong>.</p>
            </div>
            {% endif %}
          </div>
        </div>
      </div>
    </section>

    {% if posts.length %}
    <section class="relative bg-white">
      <div class="mx-auto max-w-7xl px-6 py-14 md:py-16">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="blog-eyebrow">Todos os artigos</p>
            <h2 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Biblioteca técnica</h2>
          </div>
          <p class="text-sm text-slate-600">{{ posts | length }} artigos publicados</p>
        </div>

        <div class="mt-7 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {% for post in posts %}
          <article class="group flex h-full flex-col overflow-hidden rounded-md border border-slate-200 bg-white transition hover:-translate-y-0.5 hover:border-[#0B3B2E]/55 hover:shadow-[0_16px_34px_rgba(15,23,42,0.08)]">
            <a href="{{ post.url }}" class="block overflow-hidden">
              <img src="{{ post.data.coverImage or '/assets/img/hero-about.jpg' }}" alt="{{ post.data.title }}" class="h-52 w-full object-cover transition duration-300 group-hover:scale-[1.03]" loading="lazy" decoding="async">
            </a>
            <div class="flex grow flex-col p-6">
              <p class="blog-eyebrow">{{ post.date | readableDate }}</p>
              <h3 class="mt-3 text-xl font-semibold leading-tight text-slate-900">
                <a href="{{ post.url }}" class="hover:text-[#0B3B2E]">{{ post.data.title }}</a>
              </h3>
              <p class="mt-3 grow text-sm leading-7 text-slate-600">{{ post.data.description }}</p>
              <div class="mt-5 flex items-center justify-between gap-3">
                <a href="{{ post.url }}" class="inline-flex btn-text">Ler artigo</a>
                {% if post.data.topics and post.data.topics.length %}
                <span class="rounded-full border border-slate-300 bg-slate-50 px-3 py-1 text-xs text-slate-700">{{ post.data.topics[0] }}</span>
                {% endif %}
              </div>
            </div>
          </article>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="relative border-t border-slate-200 bg-[#f7f9f9]">
      <div class="mx-auto max-w-7xl px-6 py-12 md:py-14">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="blog-eyebrow">Percursos de Leitura</p>
            <h2 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Comece pelo tema certo</h2>
          </div>
          <a href="/contacto/" class="btn-text">Precisa de apoio técnico?</a>
        </div>
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          <a href="/servicos/avaliacao-diagnostico/" class="rounded-md border border-slate-200 bg-white p-5 transition hover:border-[#0B3B2E]/55 hover:shadow-sm">
            <p class="text-lg font-semibold text-slate-900">Avaliação de Solos</p>
            <p class="mt-2 text-sm leading-7 text-slate-600">Como reduzir risco e evitar paragens na fase de escavação.</p>
          </a>
          <a href="/servicos/remediacao-tratamento/" class="rounded-md border border-slate-200 bg-white p-5 transition hover:border-[#0B3B2E]/55 hover:shadow-sm">
            <p class="text-lg font-semibold text-slate-900">Remediação</p>
            <p class="mt-2 text-sm leading-7 text-slate-600">Estratégias por fases para recuperar terreno com controlo técnico.</p>
          </a>
          <a href="/servicos/conformidade-regulacao/" class="rounded-md border border-slate-200 bg-white p-5 transition hover:border-[#0B3B2E]/55 hover:shadow-sm">
            <p class="text-lg font-semibold text-slate-900">Conformidade</p>
            <p class="mt-2 text-sm leading-7 text-slate-600">Documentação e processos para manter o projeto em conformidade.</p>
          </a>
        </div>
      </div>
    </section>
    {% endif %}
  </main>

  {% include "partials/footer.njk" %}

  {% include "partials/floating-widgets.njk" %}

  <script src="/assets/vendor/lucide.min.js" defer></script>
  <script src="/assets/site.js" defer></script>
</body>
</html>
